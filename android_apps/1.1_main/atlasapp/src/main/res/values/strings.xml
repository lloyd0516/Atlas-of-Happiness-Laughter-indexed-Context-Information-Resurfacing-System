    <string name="caption_custom">Manual mode: tune streaming, 30s audio clip/context retention, detection thresholds, event grouping, and auto photo/video behavior.</string>
    <string name="config_chunk_ms">Audio chunk (ms)</string>
    <string name="config_chunk_ms_desc">Audio upload granularity for Speechmatics realtime. Smaller values reduce streaming latency but increase websocket/message overhead.</string>
    <string name="config_clip_duration">Clip duration (s)</string>
    <string name="config_clip_duration_desc">Length of each saved WAV audio clip. Current design keeps laughter/context WAV clips at 30s; auto capture is throttled over two clips, i.e. 60s when this is 30.</string>
    <string name="config_neighbor">Context neighbor clips</string>
    <string name="config_neighbor_desc">How many neighboring WAV clips before/after a laughter clip can be retained as possible speech context.</string>
    <string name="config_event_window">Event window (s)</string>
    <string name="config_event_window_desc">Maximum gap between adjacent accepted laughter detections to keep them in the same laughter event. User prompt appears when the event ends.</string>
    <string name="config_laughter_confidence">Laughter confidence (%)</string>
    <string name="config_laughter_confidence_desc">Minimum Speechmatics confidence required to accept an AudioEventEnded laughter detection. Values below this are logged as rejected and do not join an event.</string>
    <string name="config_laughter_min_duration">Laughter min duration (ms)</string>
    <string name="config_laughter_min_duration_desc">Minimum accepted laughter detection duration computed from Speechmatics end_time - start_time; 0 disables this filter.</string>
    <string name="config_trigger_video">Trigger video duration (s)</string>
    <string name="config_trigger_video_desc">Length of each automatic video capture. Auto capture starts after accepted laughter, but is throttled to once per two audio clips (60s with 30s clips).</string>
    <string name="config_trigger_photo">Trigger photo count</string>
    <string name="config_trigger_photo_desc">How many auto photos are captured with each throttled automatic capture trigger.</string>
