    <string name="caption_frequent">更敏感，clip 更短，保留更多前后上下文。</string>
    <string name="caption_medium">均衡模式，适合当前原型的日常测试。</string>
    <string name="caption_sparse">更稀疏，clip 更长，事件之间间隔更大。</string>
    <string name="caption_custom">手动模式：可调音频流、30s WAV 上下文保留、检测阈值、event 聚合与自动拍照/录像行为。</string>
    <string name="config_chunk_ms">音频分块（ms）</string>
    <string name="config_chunk_ms_desc">发送给 Speechmatics realtime 的音频分块粒度。数值更小延迟更低，但 websocket/message 开销更高。</string>
    <string name="config_clip_duration">片段时长（s）</string>
    <string name="config_clip_duration_desc">保存 laughter/context WAV 的单个音频片段长度。当前设计建议保持 30s；自动采集按四个 clip 节流，即 30s clip 时每 120s 最多触发一次。</string>
    <string name="config_neighbor">上下文相邻片段数</string>
    <string name="config_neighbor_desc">laughter clip 前后可保留为 possible speech context 的相邻 WAV clip 数量。</string>
    <string name="config_event_window">事件窗口（s）</string>
    <string name="config_event_window_desc">相邻两次已接受 laughter detection 的最大间隔（默认 20 分钟）；小于该值归入同一个 laughter event。用户弹窗在 event 结束后出现。</string>
    <string name="config_laughter_confidence">笑声置信度（%）</string>
    <string name="config_laughter_confidence_desc">接受 Speechmatics AudioEventEnded laughter detection 的最低置信度。低于该值会记录为 rejected，不进入 event。</string>
    <string name="config_laughter_min_duration">笑声最短时长（ms）</string>
    <string name="config_laughter_min_duration_desc">接受 laughter detection 所需的最短时长，由 Speechmatics end_time - start_time 计算；0 表示不启用该过滤。</string>
    <string name="config_trigger_video">触发录像时长（s）</string>
    <string name="config_trigger_video_desc">每次自动录像的长度。接受到 laughter 后会触发自动采集，但按四个音频 clip 节流；30s clip 时每 120s 最多一次。</string>
    <string name="config_trigger_photo">触发拍照数量</string>
    <string name="config_trigger_photo_desc">每次通过节流后的自动采集触发时，自动拍照的张数。</string>
