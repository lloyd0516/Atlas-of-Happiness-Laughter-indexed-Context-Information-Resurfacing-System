<?xml version="1.0" encoding="utf-8"?>
<!-- Brighter/wider glow while a Joyful session is actively recording. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerColor="#55F08A3C"
                android:startColor="#77F08A3C"
                android:endColor="#00F08A3C" />
        </shape>
    </item>
</layer-list>
