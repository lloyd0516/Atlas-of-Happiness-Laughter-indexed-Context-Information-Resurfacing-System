<?xml version="1.0" encoding="utf-8"?>
<!-- Soft radial glow behind the record button, per materials/recording页面.jpg. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerColor="#33F08A3C"
                android:startColor="#55F08A3C"
                android:endColor="#00F08A3C" />
        </shape>
    </item>
</layer-list>
