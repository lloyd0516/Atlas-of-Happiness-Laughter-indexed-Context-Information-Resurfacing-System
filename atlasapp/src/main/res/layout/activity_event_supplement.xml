<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtSupplementStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textColor="@color/atlas_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtSupplementTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/atlas_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputSupplementAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/atlas_section_bg"
        android:padding="14dp"
        android:textColor="@color/atlas_text_primary" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSupplementSkip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/atlas_chip"
            android:text="@string/supplement_skip"
            android:textAllCaps="false"
            android:textColor="@color/atlas_text_secondary" />

        <Button
            android:id="@+id/btnSupplementNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/atlas_button_soft"
            android:text="@string/supplement_next"
            android:textAllCaps="false"
            android:textColor="@color/atlas_text_primary" />
    </LinearLayout>
</LinearLayout>
