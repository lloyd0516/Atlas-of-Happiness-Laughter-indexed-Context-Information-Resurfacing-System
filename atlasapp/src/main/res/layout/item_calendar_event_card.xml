<?xml version="1.0" encoding="utf-8"?>
<!-- Requirement 2.II: calendar day-events list card, per materials/日历组织视图.jpg — play button,
     waveform icon, orange duration chip, location/time caption. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/atlas_floating_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txtCalEventTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mock_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgCalEventPlay"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_atlas_play_circle" />

        <ImageView
            android:id="@+id/imgCalEventWaveform"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/ic_atlas_waveform" />

        <TextView
            android:id="@+id/txtCalEventDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/mock_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtCalEventMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="4dp"
        android:textColor="@color/mock_text_muted"
        android:textSize="12sp" />
</LinearLayout>
