<?xml version="1.0" encoding="utf-8"?>
<!--
    Requirement 1 (redesign pass): matches materials/recording页面.jpg exactly —
    connection status pill, orange laughing-face icon, artistic prompt, glowing record
    button, "今日数据" stat card, "最近记录" card. The live USB camera SurfaceView lives in
    dialog_camera_preview.xml and only exists while that dialog is shown.
    Legacy 1.1_main manual controls (preview/capture/record/thumbnail/brightness) are kept
    in the XML for their Java wiring but permanently hidden — no UI entry point remains.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- Status pill: "设备已连接" per mockup top-right chip. -->
        <LinearLayout
            android:id="@+id/deviceStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/atlas_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/deviceStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/atlas_calendar_event_dot" />

            <TextView
                android:id="@+id/txtDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/device_connected"
                android:textColor="@color/atlas_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgLaughingFace"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:src="@drawable/ic_atlas_laughing_face"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtRecordingPromptArt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="@string/recording_idle_headline"
            android:textColor="@color/atlas_text_primary"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLaughingFace" />

        <!-- Glow halo behind the button, per mockup's soft radial light. -->
        <FrameLayout
            android:id="@+id/recordCircleFrame"
            android:layout_width="236dp"
            android:layout_height="236dp"
            android:layout_marginTop="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtRecordingPromptArt">

            <ImageView
                android:id="@+id/recordCircleGlow"
                android:layout_width="236dp"
                android:layout_height="236dp"
                android:layout_gravity="center"
                android:background="@drawable/atlas_record_glow_halo" />

            <Button
                android:id="@+id/btnRecordCircle"
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:layout_gravity="center"
                android:background="@drawable/atlas_record_button_idle"
                android:elevation="2dp"
                android:text="@string/recording_idle_prompt"
                android:textAllCaps="false"
                android:textColor="@color/atlas_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="24dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/recordingPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="@string/recording_active_prompt"
            android:textColor="@color/atlas_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recordCircleFrame" />

        <!-- "今日数据" stat card: laughter count / recorded duration / joyful moments, live-updated. -->
        <LinearLayout
            android:id="@+id/todayStatsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/atlas_stat_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recordingPrompt">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_stats_title"
                android:textColor="@color/atlas_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatLaughterCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/atlas_primary_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/today_stats_laughter_count"
                        android:textColor="@color/atlas_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0分"
                        android:textColor="@color/atlas_primary_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/today_stats_duration"
                        android:textColor="@color/atlas_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatEventCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/atlas_primary_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/today_stats_event_count"
                        android:textColor="@color/atlas_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- "最近记录" recent events card. -->
        <TextView
            android:id="@+id/recentRecordsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="@string/recent_records_title"
            android:textColor="@color/atlas_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/todayStatsCard" />

        <LinearLayout
            android:id="@+id/recentRecordsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recentRecordsTitle" />

        <TextView
            android:id="@+id/recentRecordsEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/atlas_section_bg"
            android:padding="16dp"
            android:text="@string/recent_records_empty"
            android:textColor="@color/atlas_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recentRecordsTitle" />

        <!--
            Legacy manual controls: kept only so existing Java field wiring (mCameraThread manual
            preview/capture/record, thumbnail, brightness seekbar) still compiles and functions
            internally. Permanently hidden, no toggle, no UI entry point.
        -->
        <LinearLayout
            android:id="@+id/manualControlsPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/recentRecordsContainer">

            <ImageView android:id="@+id/thumbnailView" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnPreview" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnCapture" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnRecord" android:layout_width="1dp" android:layout_height="1dp" />
            <Button android:id="@+id/btnProperty" android:layout_width="1dp" android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recordingLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/record_layout_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/manualControlsPanel">

            <ImageView
                android:id="@+id/recordingImage"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/recording" />

            <TextView
                android:id="@+id/recordingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="00:00"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/seekbarLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/recordingLayout">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="1dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/seekBarText"
                android:layout_width="1dp"
                android:layout_height="1dp" />
        </LinearLayout>

    </android.support.constraint.ConstraintLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
