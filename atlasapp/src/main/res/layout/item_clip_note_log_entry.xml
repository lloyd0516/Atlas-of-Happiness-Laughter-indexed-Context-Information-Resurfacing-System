<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in a clip's timestamped user-notes log — chat-message style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/atlas_chip"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/txtNoteLogTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/mock_text_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/txtNoteLogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/mock_text_primary"
        android:textSize="12sp" />
</LinearLayout>
