<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atlas_background"
    android:orientation="vertical">

    <!-- Requirement 3: map / calendar / timeline organizational views, switched by tab. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_heading"
            android:textColor="@color/atlas_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <android.support.design.widget.TabLayout
        android:id="@+id/reviewTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:tabIndicatorColor="@color/atlas_primary_dark"
        app:tabSelectedTextColor="@color/atlas_text_primary"
        app:tabTextColor="@color/atlas_text_secondary">

        <android.support.design.widget.TabItem
            android:text="@string/review_tab_map" />

        <android.support.design.widget.TabItem
            android:text="@string/review_tab_calendar" />

        <android.support.design.widget.TabItem
            android:text="@string/review_tab_timeline" />
    </android.support.design.widget.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!--
            Tab 1: Map (redesign pass) — per materials/地图组织视图.jpg: the map fills the whole
            panel edge-to-edge (no framed box, no padding), and every other element floats on
            top of it: a small "N个地点 · 总笑声记录" pill top-left, a "笑声轨迹" summary strip,
            and a stack of swipeable recent-event cards at the bottom.
        -->
        <FrameLayout
            android:id="@+id/panelMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/mapWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/emptyMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/mock_page_bg"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/event_map_empty"
                android:textColor="@color/mock_text_muted"
                android:visibility="gone" />

            <!-- "3个地点 · 12次笑声记录" floating pill, top-left. -->
            <LinearLayout
                android:id="@+id/mapStatsPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:background="@drawable/atlas_map_stat_pill"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/txtMapStatsHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mock_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMapStatsSubline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/mock_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bottom floating panel: "笑声轨迹" summary strip + stacked swipeable event cards. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/mapTrailSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/atlas_floating_card_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_atlas_laughing_face" />

                    <TextView
                        android:id="@+id/txtMapTrailSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.hry.camera.usbcamerademo.StackedCardView
                    android:id="@+id/mapEventStack"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Tab 2: Calendar (redesign pass, per materials/日历组织视图.jpg). -->
        <ScrollView
            android:id="@+id/panelCalendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mock_page_bg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCalendarPrevMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/atlas_floating_card_bg"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="&lt;"
                        android:textColor="@color/mock_text_primary" />

                    <TextView
                        android:id="@+id/txtCalendarMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/mock_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCalendarNextMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/atlas_floating_card_bg"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="&gt;"
                        android:textColor="@color/mock_text_primary" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/calendarWeekdayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:columnCount="7" />

                <GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:columnCount="7" />

                <TextView
                    android:id="@+id/txtCalendarDayHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/mock_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calendarEmptyView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/atlas_floating_card_bg"
                    android:padding="16dp"
                    android:text="@string/review_calendar_pick_day"
                    android:textColor="@color/mock_text_muted" />

                <LinearLayout
                    android:id="@+id/calendarDayEventsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 3: Timeline -->
        <ScrollView
            android:id="@+id/panelTimeline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/emptyTimelineView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/atlas_section_bg"
                    android:padding="16dp"
                    android:text="@string/home_empty"
                    android:textColor="@color/atlas_text_secondary" />

                <LinearLayout
                    android:id="@+id/timelineContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
