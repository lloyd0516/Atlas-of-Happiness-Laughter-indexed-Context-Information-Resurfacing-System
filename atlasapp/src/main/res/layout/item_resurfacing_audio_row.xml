<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resurfacingAudioRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgResurfacingAudioPlay"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/audio_playback_play"
        android:src="@drawable/ic_atlas_play_circle" />

    <com.hry.camera.usbcamerademo.AtlasWaveformView
        android:id="@+id/waveResurfacingAudio"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/txtResurfacingAudioDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/mock_text_muted"
        android:textSize="12sp" />
</LinearLayout>
